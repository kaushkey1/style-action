# Local MCP config (machine-specific)
.mcp.local.json

# Local-only files — paired with `import.meta.glob('./*.local.tsx', { eager: true })`
# in tracked files. Any *.local.{ts,tsx,js,jsx} sits next to its host module,
# gets auto-discovered when present, and stays invisible in git. Use this for
# personal sandboxes, experiments, or per-developer additions to shared modules.
*.local.tsx
*.local.ts
*.local.jsx
*.local.js

# Motion Lab — local-only animation A/B sandbox; never commit these
src/modules/docs/pages/MotionLabPage.tsx
src/modules/docs/components/motion-lab/
.claude/motion-lab-*.png

# Design Lab — local-only DEV design sandbox; never commit these
src/modules/_design-lab/

# Buying module — generated evidence and offline export (build outputs, ~20 MB)
deliverables/buying-evidence/
deliverables/Impetus_Buying_Offline.html
# Real-data review screenshots stay local (security review W8, 4 Oct 2026)
.impeccable/review/

