{
  "5331f8af-b091-cb9f-e2a4-d247f2acaf16"  : { 
    "org_name"       : "Reliance Industries Limited",
    "schedule_cron"  : "0 6 * * *",
    "bq_project_id"  : "fynd-jio-impetus-prod",
    "data_sources"   : [
      {"name" : "stock",           "backend" : "bq", "level" : "option",  "merge_columns" : ["site", "option_code"], "interval" : 14,  "is_active" : true}, 
      {"name" : "sales",           "backend" : "bq", "level" : "option",  "merge_columns" : ["site", "option_code", "brand_id", "fashion_grade", "mh_sbu_cd", "mh_segment_cd", "mh_family_cd", "mh_brick_cd", "mh_brick_desc"], "interval" : 14,  "is_active" : true}, 
      {"name" : "replenishments",  "backend" : "pg", "level" : "article", "merge_columns" : ["site", "option_code"], "interval" : 7,  "is_active" : false}, 
      {"name" : "pullbacks",       "backend" : "pg", "level" : "option",  "merge_columns" : ["site", "option_code"], "interval" : 7,  "is_active" : false}, 
      {"name" : "redistribution",  "backend" : "pg", "level" : "article", "merge_columns" : ["site", "option_code"], "interval" : 7,  "is_active" : false}
    ],
    "custom_data_sources": [
      {
        "name"           : "fill_rate", 
        "query_template" : "fill_rate_store_brand_brick", 
        "backend"        : "bq", 
        "level"          : "option",  
        "merge_columns"  : ["site", "brand_id", "fashion_grade", "mh_segment_cd", "mh_family_cd", "mh_brick_cd"],
        "interval"       : 14, 
        "is_active"      : true
      }
    ],
    "merge_columns"  : ["site", "article"],
    "non_null_cols"  : ["closing_stock_qty", "total_dc_stock", "fill_rate", "plan_options", "option_count", 
                        "fill_rate_options", "target_brick_qty", "target_brick_gap", "target_option_qty", "target_option_gap"],
    "tables"   : {
      "sales"                 : "fynd-jio-impetus-prod.impetus_prod_buyplan_integrations.sales",
      "stock"                 : "fynd-jio-impetus-prod.impetus_prod_buyplan_integrations.Stock",
      "inward"                : "fynd-jio-impetus-prod.impetus_prod_buyplan_integrations.INWARD",
      "catalog"               : "fynd-jio-impetus-prod.impetus_prod_buyplan_integrations.CATALOG",
      "site"                  : "fynd-jio-impetus-prod.impetus_planning.stores",
      "planogram_quantities"  : "fynd-jio-impetus-prod.impetus_planning.store_planogram",
      "planogram_groups"      : "fynd-jio-impetus-prod.impetus_planning.store_planogram_groups",
      "store_lead_times"      : "fynd-jio-impetus-prod.impetus_planning.store_lead_times",
      "plm_sku"               : "fynd-jio-impetus-prod.plmpublic.ed_sku",
      "plm_style"             : "fynd-jio-impetus-prod.plmpublic.ed_style",
      "forecasts"             : "impetus_planning.results_article_weekly",
      "forecast_tracker"      : "impetus_planning.results_tracker",
      "anr_runs"              : "impetus_planning.anr_runs",
      "anr_redistribution"    : "impetus_planning.anr_redistribution_new",
      "grn"                   : "fynd-jio-impetus-prod.analytics_scanpack.public_grn",
      "grn_item"              : "fynd-jio-impetus-prod.analytics_scanpack.public_grn_item"
    },
    "data_points"   : [
      {
        "name"          : "ros",
        "type"          : "calculated",
        "formula"       : "result_df['billing_qty'] / 2",
        "is_active"     : true,
        "description"   : "Billing Quantity / 2 - since is for 2 weeks and we need ros per week"
      }
    ],
    "filter_rules": [
      {
        "name"          : "exclude_no_planogram_entries",
        "field"         : "plan_qty", 
        "operator"      : "is_not_null",
        "is_active"     : true,
        "description"   : "ROS >= Average ROS across stores"
      },
      {
        "name"          : "over_fill_rate_check",
        "field"         : "target_brick_gap", 
        "operator"      : ">",
        "value"         : 0,
        "is_active"     : true,
        "description"   : "Excess Stock > 0 (Over an above 120% fill rate)"
      }
    ],
    "pullback_calculation_template" : {
      "name"        : "lowest_ros_first",
      "match_on"    : "option_code",
      "description" : "For the brick target gap pull stock for options sorted by ROS (lowest ROS first)",
      "is_active"   : true
    },
    "constants": {
      "batch_size"            : "1000",
      "trailing_days"         : 14,
      "default_cover_days"    : 60,
      "min_sales_threshold"   : 0.01,
      "days_per_week"         : 7,
      "segments_in_scope"     : ["42", "55", "56", "80"],
      "sub_formats_in_scope"  : ["14", "42", "43", "49"],
      "brands_in_scope"       : ["F085", "04042","F086", "F137", "F133", "04017"],
      "run_date"              : "2026-02-25",
      "default_fill_rate"     : 1.2,
      "comments_for_ui"       : "Planogram Overfill based Pullback",
      "trailing_window"       : 7,
      "pullback_cooldown"     : 14,
      "po_enabled"            : true,
      "po_dry_run"            : true,
      "po_overfill_threshold" : 120
    }
  }
}