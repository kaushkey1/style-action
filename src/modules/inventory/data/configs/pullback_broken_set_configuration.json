{
  "5331f8af-b091-cb9f-e2a4-d247f2acaf16"  : { 
    "org_name"       : "Reliance Industries Limited",
    "schedule_cron"  : "0 6 * * *",
    "bq_project_id"  : "fynd-jio-impetus-prod",
    "data_sources"   : [
      {"name" : "stock",          "backend" : "bq", "level" : "option",  "merge_columns" : ["site", "option_code"], "interval" : 7,  "is_active" : true},
      {"name" : "sales",          "backend" : "bq", "level" : "option",  "merge_columns" : ["site", "option_code", "brand_id", "fashion_grade", "mh_sbu_cd", "mh_segment_cd", "mh_family_cd", "mh_brick_cd", "mh_brick_desc"], "interval" : 7,  "is_active" : true}, 
      {"name" : "inward",         "backend" : "bq", "level" : "option",  "merge_columns" : ["site", "option_code", "brand_id", "fashion_grade", "mh_segment_cd", "mh_family_cd", "mh_brick_cd", "mh_brick_desc"], "interval" : 4,  "is_active" : true}, 
      {"name" : "str",            "backend" : "bq", "level" : "option",  "merge_columns" : ["site", "option_code"], "interval" : 42, "is_active" : true},
      {"name" : "replenishments", "backend" : "pg", "level" : "article", "merge_columns" : ["site", "article"],     "interval" : 7,  "is_active" : false}, 
      {"name" : "pullbacks",      "backend" : "pg", "level" : "option",  "merge_columns" : ["site", "option_code"], "interval" : 7,  "is_active" : false}, 
      {"name" : "redistribution", "backend" : "pg", "level" : "article", "merge_columns" : ["site", "article"],     "interval" : 7,  "is_active" : false}
    ],
    "custom_data_sources": [
      {
        "name"           : "fill_rate", 
        "query_template" : "fill_rate_store_brand_brick", 
        "backend"        : "bq", 
        "level"          : "option",  
        "merge_columns"  : ["site", "brand_id", "fashion_grade", "mh_segment_cd", "mh_family_cd", "mh_brick_cd"],
        "interval"       : 14, 
        "is_active"      : true
      },
      {
        "name"           : "broken_sizes", 
        "query_template" : "broken_sizes", 
        "backend"        : "bq", 
        "level"          : "option",  
        "merge_columns"  : ["site", "option_code"], 
        "interval"       : 14, 
        "is_active"      : true
      }
    ],
    "merge_columns"  : ["site", "article"],
    "non_null_cols"  : ["closing_stock_qty", "total_dc_stock", "fill_rate", "plan_options", "option_count", "po_qty", "str", "avg_str",
                        "fill_rate_options", "target_brick_qty", "target_brick_gap", "target_option_qty", "target_option_gap"],
    "tables"         : {
      "sales"                 : "fynd-jio-impetus-prod.impetus_prod_buyplan_integrations.sales",
      "stock"                 : "fynd-jio-impetus-prod.impetus_prod_buyplan_integrations.Stock",
      "catalog"               : "fynd-jio-impetus-prod.impetus_prod_buyplan_integrations.CATALOG",
      "inward"                : "fynd-jio-impetus-prod.impetus_prod_buyplan_integrations.INWARD", 
      "site"                  : "fynd-jio-impetus-prod.impetus_planning.stores",
      "planogram_quantities"  : "fynd-jio-impetus-prod.impetus_planning.store_planogram",
      "planogram_groups"      : "fynd-jio-impetus-prod.impetus_planning.store_planogram_groups",
      "store_lead_times"      : "fynd-jio-impetus-prod.impetus_planning.store_lead_times",
      "plm_sku"               : "fynd-jio-impetus-prod.plmpublic.ed_sku",
      "plm_style"             : "fynd-jio-impetus-prod.plmpublic.ed_style",
      "anr_runs"              : "impetus_planning.anr_runs",
      "anr_redistribution"    : "impetus_planning.anr_redistribution_new"
    },
    "input_custom_columns" :[
      {
        "data_source"   : "str",
        "column"        : "str",
        "formula"       : "(SUM(billing_qty) / (SUM(billing_qty) + SUM(total_stk_qty))) * 100"
      },
      {
        "data_source"   : "str",
        "column"        : "avg_str",
        "formula"       : "AVG((SUM(billing_qty) / (SUM(billing_qty) + SUM(total_stk_qty))) * 100) OVER (PARTITION BY s.option_code)"
      }
    ],
    "data_points"   : [
      {
        "name"          : "pullback_qty",
        "type"          : "static",
        "formula"       : "closing_stock_qty",
        "is_active"     : true,
        "description"   : "closing_stock_qty"
      },
      {
        "name"          : "lead_time_days", 
        "type"          : "constant",
        "formula"       : "4",
        "is_active"     : true,
        "description"   : "Lead time days"
      }
    ],
    "filter_rules": [
      {
        "name"          : "exclude_no_planogram_entries",
        "field"         : "plan_qty", 
        "operator"      : "is_not_null",
        "is_active"     : true,
        "description"   : "ROS >= Average ROS across stores"
      },
      {
        "name"          : "non_core_check",
        "field"         : "fashion_grade", 
        "operator"      : "!=",
        "value"         : "0001",
        "is_active"     : false,
        "description"   : "Non Core Fashion Products"
      },
      {
        "name"          : "low_str_check",
        "field"         : "str", 
        "operator"      : "<=",
        "value"         : "col(avg_str)",
        "is_active"     : true,
        "description"   : "STR < Average STR for the store-option combination"
      },
      {
        "name"          : "broken_size_index_check",
        "field"         : "broken_size_index", 
        "operator"      : ">",
        "value"         : 50,
        "is_active"     : true,
        "description"   : "BSI > 50%"
      },
      {
        "name"          : "no_inwards_check",
        "field"         : "po_qty", 
        "operator"      : "==",
        "value"         : 0,
        "is_active"     : true,
        "description"   : "No expected inwards"
      },
      {
        "name"          : "fill_rate_check",
        "field"         : "fill_rate_brick",
        "operator"      : ">=",
        "value"         : 90,
        "is_active"     : true,
        "description"   : "Fill rate >= 90%"
      }
    ],
    "replacement_template" : {
      "name"        : "incoming_po_select",
      "match_on"    : "option_code",
      "description" : "Pick the matching hierarchy from incoming POs as replacement without repeat and filtering out ones that do not have a replacememt",
      "is_active"   : true
    },
    "constants": {
      "batch_size"            : "1000",
      "trailing_days"         : 14,
      "min_sales_threshold"   : 0.01,
      "days_per_week"         : 7,
      "segments_in_scope"     : ["42", "55", "56", "80"],
      "sub_formats_in_scope"  : ["14", "42", "43", "49"],
      "brands_in_scope"       : ["F085", "F086", "F639", "D699"],
      "run_date"              : "2026-02-25",
      "default_fill_rate"     : 0.9,
      "comments_for_ui"       : "Broken Set based Pullback",
      "trailing_window"       : 7,
      "pullback_cooldown"     : 14,
      "br_enabled"            : true,
      "br_min_bsi"            : 0.5,
      "br_fill_rate_floor"    : 90,
      "br_exclude_core"       : true,
      "br_require_no_pos"     : true
    }
  }
}